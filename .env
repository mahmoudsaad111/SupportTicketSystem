# --- SQL Server ---
# 'sa' password for the sqlserver container. Must satisfy SQL Server's
# password policy: 8+ characters, with upper+lower case, a digit, and a
# symbol — or the sqlserver container will fail to start.
SA_PASSWORD=YourStrong!Passw0rd

# --- HTTPS dev certificate ---
# The backend keeps using https://localhost:44376 (already hardcoded into
# Angular's environment.prod.ts) so the frontend needs no changes. That
# means the backend container needs a real, browser-trusted HTTPS dev cert
# mounted in, generated once on your Windows machine with:
#
#   dotnet dev-certs https -ep %USERPROFILE%\.aspnet\https\aspnetapp.pfx -p devcertpass123
#   dotnet dev-certs https --trust
#
# CERT_PATH must be the absolute Windows folder containing that .pfx file,
# and CERT_PASSWORD must match the -p value you used above exactly.
CERT_PATH=C:\Users\mahmo\.aspnet\https
CERT_PASSWORD=devcertpass123
